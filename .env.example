# Copy this file to `.env` and fill with your environment values (DO NOT commit `.env`).
# Example:
# POSTGRES_URI=postgresql://user:pass@host:5432/dbname

# --- Postgres ---
POSTGRES_URI=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- MongoDB ---
MONGO_URI=
MONGO_DB_NAME=ID2
MONGO_COLLECTION_NAME=propiedades

# --- Astra/Cassandra (AstraDB Data API) ---
ASTRA_DB_TOKEN=
ASTRA_DB_ENDPOINT=
ASTRA_DB_NAME=airbnb
ASTRA_COLLECTION_NAME=historial_vistas
ASTRA_AVAILABILITY_TABLE=disponibilidad_propiedad
ASTRA_VISITS_TABLE=historial_vistas

# --- Redis (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Other ---
ENVIRONMENT=development